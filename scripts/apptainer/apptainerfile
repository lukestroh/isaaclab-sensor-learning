nano /apps/samples/openfoam/openfoam13.def
Apptainer build openfoam13.def openfoam13.sif

Bootstrap: docker
From: ubuntu:24.04

%labels
    Version isaaclab3.0
    MyLabel isaaclab

%post
    apt-get update && apt-get install -y wget curl gnupg lsb-release software-properties-common cmake build-essential
    curl -LsSf https://astral.sh/uv/install.sh | sh
    git clone git@github.com:isaac-sim/IsaacLab.git --branch v3.0.0-beta2
    cd IsaacLab
    uv venv --python 3.12 --seed venv
    source venv/bin/activate
    uv pip install "isaacsim[all,extscache]==6.0.0.1" --extra-index-url https://pypi.nvidia.com --index-strategy unsafe-best-match --prerelease=allow
    uv pip install -U torch==2.10.0 torchvision==0.25.0 --index-url https://download.pytorch.org/whl/cu128
    uv pip install plotly
    ./isaaclab.sh --install

%environment

%runscript
    exec "$@"




Bootstrap: docker
From: ubuntu:24.04

%labels
    Version Openfoam13
    MyLabel testing

%post
    apt-get update && apt-get install -y wget gnupg lsb-release software-properties-common
    wget -O - https://dl.openfoam.org/gpg.key > /etc/apt/trusted.gpg.d/openfoam.asc
    add-apt-repository http://dl.openfoam.org/ubuntu

    #update package
    apt update

    #install openfoam13
    apt -y install openfoam13

%environment
    source /opt/openfoam13/etc/bashrc

%runscript
    exec "$@"
