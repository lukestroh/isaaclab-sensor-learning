#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "pruning_robot"
    doc = """Generated from Composed Stage of root layer /tmp/tmpcbrr1rnm/pruning_robot.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_ag_robot__ur10e_pky9mj6s/usdex_ag_robot__ur10e/pruning_robot.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_ag_robot__ur10e_pky9mj6s/temp_ag_robot__ur10e/ag_robot__ur10e.usd


Generated from Composed Stage of root layer /home/luke/IsaacLab/source/isaaclab-sensor-learning/source/isaaclab_sensor_learning/isaaclab_sensor_learning/usd/ag_robot__ur10e/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "pruning_robot" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Geometry"
    {
        over "amiga__base"
        {
            over "amiga__body"
            {
                over "amiga__tool0"
                {
                    over "linear_slider__base"
                    {
                        over "linear_slider__base_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "linear_slider__moving_base" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "linear_slider__joint1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__linear_slider__base_linkbase_joint_no0P" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

