over "linear_slider"
{
    over "Physics"
    {
        def MjcActuator "linear_slider__joint1_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -200, -30, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 10
            uniform double mjc:forceRange:min = -10
            uniform double[] mjc:gainPrm = [200, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            prepend rel mjc:target = </linear_slider/Physics/linear_slider__joint1>
        }

        over "linear_slider__joint1" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
        }
    }

