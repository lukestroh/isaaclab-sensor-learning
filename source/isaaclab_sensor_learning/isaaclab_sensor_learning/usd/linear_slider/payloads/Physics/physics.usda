        {
            bool newton:selfCollisionEnabled = 0
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.061, 0.65, 0.661)
            float physics:mass = 20
            quatf physics:principalAxes = (1, 0, 0, 0)

            over "linear_slider__moving_base" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.0915, 0.975, 0.9915)
                float physics:mass = 10
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "box" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }
            }

            over "box" (
                prepend apiSchemas = ["NewtonCollisionAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        def PhysicsFixedJoint "linear_slider__base_fixed"
        {
            custom rel physics:body0
            custom rel physics:body1
            prepend rel physics:body1 = </linear_slider/Geometry/linear_slider__base_link>
            point3f physics:localPos0 = (0, 0, 1)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
        def PhysicsPrismaticJoint "linear_slider__joint1" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 30
            float drive:linear:physics:maxForce = 10
            float drive:linear:physics:stiffness = 200
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "X"
            custom rel physics:body0
            prepend rel physics:body0 = </linear_slider/Geometry/linear_slider__base_link>
            custom rel physics:body1
            prepend rel physics:body1 = </linear_slider/Geometry/linear_slider__base_link/linear_slider__moving_base>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -0.4
            float physics:upperLimit = 0.4
            custom float urdf:limit:effort = 10
            custom float urdf:limit:velocity = 0.25
        }
    }
}

