#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "linear_slider"
    doc = """Generated from Composed Stage of root layer /tmp/tmpc38fdgx0/linear_slider.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_linear_slider_l7t21u5t/usdex_linear_slider/linear_slider.usdc


